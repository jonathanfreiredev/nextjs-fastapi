# Environment: "development" (default) enables SQL echo and an ephemeral JWT key.
ENV=development

# PostgreSQL connection string. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nextjs-fastapi

# Symmetric secret used to sign email-verification and password-reset tokens.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me

# Base URL of the frontend, used to build the links sent by email.
FRONTEND_URL=http://localhost:3000

# PEM contents of the RSA private key used to sign JWTs. Leave unset in
# development to use keys/private.pem (generate it with
# `uv run python scripts/generate_keys.py`), or an ephemeral key if missing.
# JWT_PRIVATE_KEY=
