# Base URL of the FastAPI backend.
BACKEND_URL=http://localhost:8000

# Supabase project URL and anon (publishable) key. Find them in the Supabase
# dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of enabled login methods: "email", "google".
# Supabase is the source of truth: a provider must also be enabled there.
NEXT_PUBLIC_AUTH_PROVIDERS=email
